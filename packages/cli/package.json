{
  "name": "@llm-ui-annotation/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The `annot` binary: what a coding agent runs to receive UI feedback and answer it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "annot": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@llm-ui-annotation/core": "workspace:*"
  },
  "devDependencies": {
    "@llm-ui-annotation/vite-plugin": "workspace:*",
    "vite": "^7.3.6"
  }
}
