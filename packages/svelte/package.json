{
  "name": "@llm-ui-annotation/svelte",
  "version": "0.0.0",
  "private": true,
  "description": "The annotation overlay: a Svelte 5 custom element with an open shadow root.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/auto.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check": "node scripts/no-host-mutation.mjs && pnpm run build && tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/no-host-mutation.mjs && eslint .",
    "test": "vitest run",
    "dev": "vite --config dev/vite.config.ts",
    "clean": "rm -rf dist",
    "dev:plugin": "vite --config dev/vite.plugin.config.ts"
  },
  "dependencies": {
    "@llm-ui-annotation/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "modern-screenshot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@llm-ui-annotation/vite-plugin": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.39.0",
    "vite": "^7.1.5"
  }
}
